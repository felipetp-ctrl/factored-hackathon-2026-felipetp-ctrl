# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=
AGENT_API_KEY=change-me
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MINUTES=15
RATE_LIMIT_PER_MINUTE=30
# v0.0.2
DEMO_MODE=true          # public demo: per-visitor workspaces, bank side without a key (synthetic data only)
NLU_MODE=auto           # auto (Claude + rule fallback; rules only without ANTHROPIC_API_KEY) | claude | rules
LLM_BUDGET_USD=20       # switch to the free rule NLU after this much model spend in the process
# LLM_DAILY_BUDGET_USD=1.0       # optional: per calendar day (ADR-026)
# LLM_WORKSPACE_BUDGET_USD=0.3   # optional: per demo workspace / browser tab
# LLM_GLOBAL_BUDGET_USD=9.5      # optional: every source together (demo + evaluation runs)
# LLM_LEDGER_URL=postgresql://…  # optional: durable spend ledger shared across processes
# LLM_METER_SOURCE=eval          # evaluation runs: meter every API call against the ledger
