# Copy to .env and fill in. .env is gitignored; production values live in render.yaml and the host's secret store.

# --- Required ---
ANTHROPIC_API_KEY=                 # empty → rule-based NLU only, the demo still works offline and for free
AGENT_API_KEY=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# --- Service ---
SESSION_TTL_MINUTES=15
RATE_LIMIT_PER_MINUTE=30
DEMO_MODE=true          # public demo: per-visitor workspaces, bank side without a key (synthetic data only, ADR-016)
NLU_MODE=auto           # auto (Claude + rule fallback; rules only without ANTHROPIC_API_KEY) | claude | rules (ADR-017)

# --- Spend caps (ADR-026) ---
LLM_BUDGET_USD=20       # switch to the free rule NLU after this much model spend in the process
# LLM_DAILY_BUDGET_USD=1.0       # optional: per calendar day
# LLM_WORKSPACE_BUDGET_USD=0.3   # optional: per demo workspace / browser tab
# LLM_GLOBAL_BUDGET_USD=9.5      # optional: every source together (demo + evaluation runs)
# LLM_LEDGER_URL=postgresql://…  # optional: durable spend ledger shared across processes
# LLM_METER_SOURCE=eval          # evaluation runs: meter every API call against the ledger
